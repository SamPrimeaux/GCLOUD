# Cloudflare Configuration
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Required scopes: Account:Workers:Edit
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Internal sync token (generate a secure random string)
INTERNAL_SYNC_TOKEN=your_internal_sync_token

# GitHub Tokens
MEAUXBILITY_GH_DASHBOARD=your_github_pat_token
GITHUB_MODELS_TOKEN=your_github_models_token
